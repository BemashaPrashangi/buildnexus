{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(style\\.css|favicon\\.ico)",
      "dest": "/$1"
    },
    {
      "src": "/buildnexus/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/buildnexus/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/buildnexus/(style\\.css|favicon\\.ico)",
      "dest": "/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/buildnexus/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/buildnexus/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
